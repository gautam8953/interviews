110. Complete Mini Project Example

Here is a compact sequence you can actually run to practice.

Step 1 – Database
CREATE DATABASE hrms;

Connect:

\c hrms
Step 2 – Schema
CREATE SCHEMA hrms;
Step 3 – Department
CREATE TABLE hrms.departments (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE
);
Step 4 – Employee
CREATE TABLE hrms.employees (
    id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    department_id BIGINT REFERENCES hrms.departments(id),
    name VARCHAR(100) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    salary NUMERIC(12,2) CHECK (salary >= 0),
    joining_date DATE DEFAULT CURRENT_DATE,
    status BOOLEAN DEFAULT TRUE
);
Step 5 – Data
INSERT INTO hrms.departments (name)
VALUES
('IT'),
('HR'),
('Finance');
INSERT INTO hrms.employees
(department_id, name, email, salary)
VALUES
(1, 'Gautam', 'gautam@example.com', 80000),
(1, 'Rahul', 'rahul@example.com', 70000),
(2, 'Amit', 'amit@example.com', 60000),
(3, 'Ravi', 'ravi@example.com', 90000);
Step 6 – Join
SELECT
    e.id,
    e.name,
    e.salary,
    d.name AS department
FROM hrms.employees e
JOIN hrms.departments d
    ON e.department_id = d.id;
Step 7 – Group
SELECT
    d.name AS department,
    COUNT(e.id) AS employee_count,
    AVG(e.salary) AS average_salary
FROM hrms.departments d
LEFT JOIN hrms.employees e
    ON e.department_id = d.id
GROUP BY d.id, d.name
HAVING COUNT(e.id) > 0;
Step 8 – Custom Function
CREATE OR REPLACE FUNCTION hrms.annual_salary(
    monthly_salary NUMERIC
)
RETURNS NUMERIC
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN monthly_salary * 12;
END;
$$;
Step 9 – Use Custom Function
SELECT
    e.name,
    e.salary AS monthly_salary,
    hrms.annual_salary(e.salary) AS annual_salary
FROM hrms.employees e;
Step 10 – Function with CASE
CREATE OR REPLACE FUNCTION hrms.salary_level(
    salary NUMERIC
)
RETURNS TEXT
LANGUAGE plpgsql
AS $$
BEGIN

    IF salary >= 80000 THEN
        RETURN 'HIGH';
    ELSIF salary >= 60000 THEN
        RETURN 'MEDIUM';
    ELSE
        RETURN 'LOW';
    END IF;

END;
$$;

Call:

SELECT
    name,
    salary,
    hrms.salary_level(salary) AS salary_level
FROM hrms.employees;
