70. Function Returning Table

You can create a function that behaves like a table/query.

CREATE OR REPLACE FUNCTION hrms.get_high_salary_employees(
    minimum_salary NUMERIC
)
RETURNS TABLE (
    employee_id BIGINT,
    employee_name VARCHAR,
    employee_salary NUMERIC
)
LANGUAGE plpgsql
AS $$
BEGIN
    RETURN QUERY
    SELECT
        id,
        name,
        salary
    FROM hrms.employees
    WHERE salary >= minimum_salary;
END;
$$;

Call:

SELECT *
FROM hrms.get_high_salary_employees(70000);
71. Function with IF/ELSE
CREATE OR REPLACE FUNCTION hrms.salary_category(
    salary NUMERIC
)
RETURNS VARCHAR
LANGUAGE plpgsql
AS $$
BEGIN

    IF salary >= 100000 THEN
        RETURN 'HIGH';

    ELSIF salary >= 50000 THEN
        RETURN 'MEDIUM';

    ELSE
        RETURN 'LOW';

    END IF;

END;
$$;

Call:

SELECT
    name,
    salary,
    hrms.salary_category(salary) AS category
FROM hrms.employees;
