			Registers the three supported languages.
			Loads the saved language from local storage.
			Switches the active language.
			Saves the user's selection so it persists after a refresh.
			Handles a simple demo form submission.

				import { Component, inject } from '@angular/core';
				import { FormsModule } from '@angular/forms';
				import {
				  TranslatePipe,
				  TranslateService
				} from '@ngx-translate/core';
				
				@Component({
				  selector: 'app-root',
				  standalone: true,
				  imports: [FormsModule, TranslatePipe],
				  templateUrl: './app.component.html',
				  styleUrl: './app.component.css'
				})
				export class AppComponent {
				  private translate = inject(TranslateService);
				
				  selectedLanguage = 'en';
				  name = '';
				  email = '';
				  message = '';
				
				  constructor() {
				    this.translate.addLangs(['en', 'hi', 'es']);
				
				    const savedLanguage =
				      typeof localStorage !== 'undefined'
				        ? localStorage.getItem('app-language')
				        : null;
				
				    const language = ['en', 'hi', 'es'].includes(savedLanguage ?? '')
				      ? savedLanguage!
				      : 'en';
				
				    this.selectedLanguage = language;
				    this.translate.use(language);
				  }
				
				  changeLanguage(language: string): void {
				    if (!['en', 'hi', 'es'].includes(language)) {
				      return;
				    }
				
				    this.selectedLanguage = language;
				    this.translate.use(language);
				
				    if (typeof localStorage !== 'undefined') {
				      localStorage.setItem('app-language', language);
				    }
				  }
				
				  submitForm(): void {
				    if (!this.name.trim() || !this.email.trim()) {
				      return;
				    }
				
				    this.message = 'FORM.SUCCESS';
				  }
				}
