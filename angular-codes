		c. Create the translation service
			File: src/app/services/translate.service.ts

			import { Injectable, inject, signal } from '@angular/core';
			import { HttpClient } from '@angular/common/http';
			import { firstValueFrom } from 'rxjs';
			
			export type Language = 'en' | 'hi' | 'kn';
			
			@Injectable({
			  providedIn: 'root'
			})
			export class TranslateService {
			  private http = inject(HttpClient);
			
			  private translations = signal<Record<string, string>>({});
			
			  async loadLanguage(language: Language): Promise<void> {
			    const data = await firstValueFrom(
			      this.http.get<Record<string, string>>(
			        `/i18n/${language}.json`
			      )
			    );
			
			    this.translations.set(data);
			  }
			
			  translate(key: string): string {
			    return this.translations()[key] ?? key;
			  }
			}
			HttpClient loads the selected JSON file.
			firstValueFrom() lets us use async/await.
			translations stores the loaded dictionary in an Angular signal.
			translate() returns the translated value or the key if it is missing.
