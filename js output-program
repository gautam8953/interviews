	function uniqueObjects(arr) {
	    var result = [];
	    var seen = {};
	
	    for (var i = 0; i < arr.length; i++) {
	
	        var obj = arr[i];
	        var key = "";
	
	        for (var prop in obj) {
	            if (obj.hasOwnProperty(prop)) {
	                key += prop + ":" + obj[prop] + "|";
	            }
	        }
	
	        if (!seen[key]) {
	            seen[key] = true;
	            result[result.length] = obj;
	        }
	    }
	    return result;
	}


