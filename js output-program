Q. write code to implement debounce in JS
A.
		function debounce(callback, delay) {
		    let timer;
		
		    return function (...args) {
		        clearTimeout(timer);
		
		        timer = setTimeout(() => {
		            callback.apply(this, args);
		        }, delay);
		    };
		}
		
		// Example
		function searchData(value) {
		    console.log("API called:", value);
		}		
		const debouncedSearch = debounce(searchData, 1000);
		
		// Simulate typing
		debouncedSearch("A");
		debouncedSearch("An");
		debouncedSearch("Ang");
		debouncedSearch("Angu");
		debouncedSearch("Angular");
		
		// Only executes once after 1 second of inactivity:
		// API called: Angular

Q. write code to implement throttling in JS
A. settimeout can be implemented using settimeout and 
	throttling can be implemented using closure and settimeout

	throttling using settimeout:
		function throttle(fn, delay) {
		    let isThrottled = false;
		
		    return function (...args) {
		        if (isThrottled) return;
		
		        isThrottled = true;
		
		        setTimeout(() => {
		            isThrottled = false;
		        }, delay);
		
		        fn.apply(this, args);
		    };
		}

		calling : 
		function handleScroll() {
		    console.log("Scroll event triggered", Date.now());
		}
		
		const throttledScroll = throttle(handleScroll, 2000);
		
		window.addEventListener("scroll", throttledScroll);


	throttling using closure: 
		function throttle(fn, delay) {
		    let lastTime = 0;
		
		    return function (...args) {
		        const currentTime = Date.now();
		
		        if (currentTime - lastTime >= delay) {
		            lastTime = currentTime;
		            fn.apply(this, args);
		        }
		    };
		}

