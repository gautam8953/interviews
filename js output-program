Q. Wrote a polyfill for the reduce array method
A. 
		Array.prototype.myReduce = function (callback, initialValue) {
		    let accumulator = initialValue;
		    let startIndex = 0;
		
		    if (arguments.length < 2) {
		        accumulator = this[0];
		        startIndex = 1;
		    }		
		    for (let i = startIndex; i < this.length; i++) {
		        accumulator = callback(accumulator, this[i], i, this);
		    }		
		    return accumulator;
		};
		
		// Example
		const numbers = [1, 2, 3, 4];		
		const output = numbers.myReduce(
		    (acc, num) => acc + num,
		    0
		);		
		console.log(output);		// 10

Q. Wrote a polyfill for the filter array method
A.
	Array.prototype.myFilter = function (callback, thisArg) {
	  if (this == null) {
	    throw new TypeError("Array.prototype.myFilter called on null or undefined");
	  }	
	  if (typeof callback !== "function") {
	    throw new TypeError("Callback must be a function");
	  }
	
	  const arr = Object(this);
	  const result = [];
	
	  for (let i = 0; i < arr.length; i++) {
	    if (i in arr) {
	      const value = arr[i];	
	      if (callback.call(thisArg, value, i, arr)) {
	        result.push(value);
	      }
	    }
	  }
	
	  return result;
	};

	const numbers = [10, 15, 20, 25, 30];
	const result = numbers.myFilter((num) => num > 20);
	console.log(result); // [25, 30]

